---
// Explainer: rotation of the operator's own BMC account password.
// Sources: metal/internal/controller/endpointprofile_controller.go (credentials:
// park, set, probe, promote; rotationDue), managementendpoint_controller.go
// (endpointClientConfig: the managed Secret wins over spec.credentialsRef).
import Explainer from '../Explainer.astro';
import Box from '../diagram/Box.astro';
import Edge from '../diagram/Edge.astro';

interface Props {
  start?: number;
}
const { start = 0 } = Astro.props;
const steps = [
  {
    title: 'Profile',
    caption: 'You write an EndpointProfile with a credentials stanza. It selects ManagementEndpoints by label and sets maxAge.',
    code: 'kubectl apply -f endpointprofile.yaml',
    state: { you: 'active', prof: 'active', you2prof: 'flow' },
    text: { 'ms-ph': 'missing', 'bmc-ph': 'factory account' },
  },
  {
    title: 'Due',
    caption: 'The endpoint convergence controller finds that the managed Secret is missing or older than maxAge. A rotation is due.',
    code: 'metal.pk.io/rotated-at < now - maxAge',
    state: { prof: 'done', ctrl: 'active', p2c: 'flow', ms: 'warn' },
    text: { 'ms-ph': 'due', 'bmc-ph': 'working password' },
  },
  {
    title: 'Park',
    caption: 'The controller makes a new password and parks it beside the working one, as next-username and next-password. The working password stays.',
    code: 'endpoint-creds-<endpoint>: next-password',
    state: { ctrl: 'active', c2ms: 'flow', ms: 'active' },
    text: { 'ms-ph': 'working + candidate', 'bmc-ph': 'working password' },
  },
  {
    title: 'Set',
    caption: 'The controller sets the candidate on the BMC through the managed account. If that fails, it uses the factory account from the Asset.',
    code: 'Redfish: AccountService',
    state: { ctrl: 'active', c2bmc: 'flow', bmc: 'active', ms: 'active', fac: 'active' },
    text: { 'ms-ph': 'working + candidate', 'bmc-ph': 'candidate set' },
  },
  {
    title: 'Prove',
    caption: 'The controller logs in with the candidate and reads the manager. Only a login that works proves the password.',
    code: 'login → GET Manager',
    state: { ctrl: 'active', c2bmc: 'flow', bmc: 'ok', ms: 'active' },
    text: { 'ms-ph': 'candidate proven', 'bmc-ph': 'candidate works' },
  },
  {
    title: 'Promote',
    caption: 'The controller promotes the candidate to username and password and stamps the time. All lanes now use the new password.',
    code: 'metal.pk.io/rotated-at: <now>',
    state: { ctrl: 'done', ms: 'ok', bmc: 'ok', ms2ops: 'flow', ops: 'active' },
    text: { 'ms-ph': 'new working password', 'bmc-ph': 'new password' },
  },
  {
    title: 'Refused',
    caption: 'If the BMC refuses the candidate, the working password stays in place. The Configured condition of the endpoint says why.',
    code: 'Configured=False RotationFailed',
    state: { ctrl: 'err', bmc: 'err', ms: 'warn', ops: 'active', ms2ops: 'flow' },
    text: { 'ms-ph': 'old working password', 'bmc-ph': 'refused' },
  },
];
const k = (p: string) => `/reference/kinds/${p}/`;
---

<Explainer title="Rotate the BMC password" steps={steps as any} start={start}>
  <svg viewBox="0 0 720 260" role="img" aria-labelledby="ex-cred-t" xmlns="http://www.w3.org/2000/svg" class="pk-stage-svg">
    <title id="ex-cred-t">An EndpointProfile makes the endpoint convergence controller rotate the operator account on each BMC. The new password is parked, set, proven by a login, then promoted in the managed Secret.</title>
    <defs>
      <marker id="pk-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 10 5 0 10z" fill="context-stroke"></path>
      </marker>
    </defs>
    <Box node="you" x={15} y={20} w={160} h={54} label="You" variant="soft" />
    <Box node="prof" x={15} y={118} w={160} h={54} label="EndpointProfile" sub="credentials.maxAge" cat="kind" href={k('endpointprofile')} />
    <Box node="ctrl" x={265} y={118} w={190} h={54} label="Endpoint convergence" sub="controller" cat="ctrl" href="/reference/controllers/endpointconvergence/" />
    <Box node="ms" x={265} y={20} w={190} h={54} label="Managed Secret" sub="-" text="ms-ph" />
    <Box node="bmc" x={545} y={118} w={160} h={54} label="BMC" sub="-" text="bmc-ph" />
    <Box node="fac" x={545} y={20} w={160} h={54} label="Factory account" sub="Asset credentialsRef" variant="soft" />
    <Box node="ops" x={265} y={206} w={190} h={44} label="All BMC sessions" sub="executor, observer" />
    <Edge node="you2prof" points={[[95, 74], [95, 118]]} />
    <Edge node="p2c" points={[[175, 145], [265, 145]]} label="selects" at={[220, 137]} />
    <Edge node="c2ms" points={[[360, 118], [360, 74]]} label="park, promote" at={[368, 100]} anchor="start" />
    <Edge node="c2bmc" points={[[455, 145], [545, 145]]} label="set, log in" at={[500, 137]} />
    <Edge node="ms2ops" points={[[265, 47], [230, 47], [230, 228], [265, 228]]} label="use" at={[222, 200]} anchor="end" />
  </svg>
</Explainer>
