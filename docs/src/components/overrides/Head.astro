---
import Default from '@astrojs/starlight/components/Head.astro';
import CategoryStyles from '../CategoryStyles.astro';

// One-word titles (Host, Pivot) are hard to tell apart in search results and tabs:
// a kind, a controller and a workflow page add their type to the <title>.
const typeLabel: Record<string, string> = { kind: 'Kind', controller: 'Controller', workflow: 'Workflow' };
const route = Astro.locals.starlightRoute;
const label = typeLabel[(route.entry.data as { type?: string }).type ?? ''];
const title = route.head.find((h) => h.tag === 'title');
// A title that names its type already ("Host controller", "Kinds") stays as it is.
if (label && title && !route.entry.data.title.toLowerCase().includes(label.toLowerCase())) {
  const page = route.entry.data.title;
  title.content = title.content?.replace(page, `${page} · ${label}`);
}
---

<Default />
<CategoryStyles />
