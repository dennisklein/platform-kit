---
// The default header, then one tab per layer of the site.
import Default from '@astrojs/starlight/components/Header.astro';
import { tabs, forRoute } from '../../lib/tabs';

const { index } = forRoute(Astro.locals.starlightRoute.sidebar as any);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="pk-header">
  <Default />
  <nav class="pk-tabs" aria-label="Layers">
    {tabs.map((t, i) => (
      <a href={`${base}/${t.href}`} aria-current={i === index ? 'page' : undefined}>{t.label}</a>
    ))}
  </nav>
</div>
