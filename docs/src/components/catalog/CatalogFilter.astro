---
// A filter box for a catalog page. It hides the rows (elements with data-q) that do
// not contain the text, and the blocks (data-block) that have no row left. Without
// JavaScript the box does not show and all rows stay.
interface Props {
  label: string;
  placeholder?: string;
}
const { label, placeholder = 'Type a name or a word' } = Astro.props;
---

<div class="pk-catfilter not-content" hidden>
  <label>
    <span>{label}</span>
    <input type="search" placeholder={placeholder} autocomplete="off" spellcheck="false" />
  </label>
  <output aria-live="polite"></output>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('.pk-catfilter')) {
    const input = box.querySelector('input')!;
    const out = box.querySelector('output')!;
    const rows = [...document.querySelectorAll<HTMLElement>('[data-q]')];
    const blocks = [...document.querySelectorAll<HTMLElement>('[data-block]')];
    box.hidden = false;
    const apply = () => {
      const q = input.value.trim().toLowerCase();
      let n = 0;
      for (const r of rows) {
        const show = !q || r.dataset.q!.includes(q);
        r.hidden = !show;
        if (show) n++;
      }
      for (const b of blocks) b.hidden = !b.querySelector('[data-q]:not([hidden])');
      out.textContent = q ? `${n} of ${rows.length}` : `${rows.length} entries`;
    };
    input.addEventListener('input', apply);
    // A link to an anchor must show its row.
    addEventListener('hashchange', () => {
      const t = document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (t?.hidden || t?.closest('[hidden]')) {
        input.value = '';
        apply();
        t.scrollIntoView();
      }
    });
    apply();
  }
</script>

<style>
  .pk-catfilter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    margin-block: 1rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--pk-rule);
    border-radius: var(--pk-radius);
    background: var(--pk-paper-2);
    position: sticky;
    inset-block-start: calc(var(--sl-nav-height) + 0.5rem);
    z-index: 2;
  }
  .pk-catfilter[hidden] {
    display: none;
  }
  label {
    display: flex;
    flex: 1 1 16rem;
    gap: 0.6rem;
    align-items: center;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--pk-ink-3);
  }
  input {
    flex: 1;
    min-inline-size: 8rem;
    padding: 0.35rem 0.6rem;
    font: 0.9rem var(--pk-font-mono);
    color: var(--pk-ink);
    background: var(--pk-paper);
    border: 1px solid var(--pk-rule-strong);
    border-radius: var(--pk-radius);
  }
  input:focus-visible {
    outline: 2px solid var(--pk-link);
    outline-offset: 1px;
  }
  output {
    font: 0.78rem var(--pk-font-mono);
    color: var(--pk-ink-3);
  }
</style>
