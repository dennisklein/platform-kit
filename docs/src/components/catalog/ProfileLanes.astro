---
// Static diagram: how EndpointProfiles become the configuration of one BMC.
// Source: metal/internal/controller/endpointprofile_controller.go (converge).
import Figure from '../diagram/Figure.astro';
import Box from '../diagram/Box.astro';
import Edge from '../diagram/Edge.astro';

const w = 130;
const h = 48;
const xs = [10, 172, 334, 496, 658];
const y = 30;
const mid = y + h / 2;
const boxes = [
  { label: 'Profiles', sub: 'merge by layer', variant: 'accent' },
  { label: 'Verified', sub: 'the right BMC', variant: 'soft' },
  { label: '1 Credentials', sub: 'managed account' },
  { label: '2 NTP', sub: 'time servers' },
  { label: '3 TLS', sub: 'certificate' },
] as const;
---

<Figure
  title="The operator merges the EndpointProfiles that match an endpoint. When the endpoint is verified, it applies credentials, then NTP, then TLS."
  caption="The lanes of an EndpointProfile. The operator applies them in this order."
  width={798}
  height={150}
  wide
>
  {boxes.map((b, i) => <Box x={xs[i]} y={y} w={w} h={h} label={b.label} sub={b.sub} variant={'variant' in b ? b.variant : undefined} />)}
  {xs.slice(0, -1).map((x, i) => <Edge points={[[x + w, mid], [xs[i + 1], mid]]} />)}
  <Box x={xs[2]} y={104} w={xs[4] + w - xs[2]} h={36} label="Configured is True when all lanes agree with the BMC" variant="ok" />
  <text class="t-small t-label" x={xs[0]} y={120} text-anchor="start">The first lane that is not complete</text>
  <text class="t-small t-label" x={xs[0]} y={136} text-anchor="start">gives the reason of Configured.</text>
</Figure>
