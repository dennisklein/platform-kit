---
// A zone: a labelled area behind boxes, for example "management cluster".
interface Props {
  x: number;
  y: number;
  w: number;
  h: number;
  label?: string;
}
const { x, y, w, h, label } = Astro.props;
---

<g class="zone-g">
  <rect class="zone" x={x} y={y} width={w} height={h}></rect>
  {label && <text class="t-small t-zone" x={x + 10} y={y + 16}>{label}</text>}
</g>
