---
// A diagram: an inline SVG with a title for screen readers and a caption. The arrow
// marker and the hatch pattern are shared (SvgDefs.astro). Put Zone, Box, Edge and
// Label inside. The class vocabulary is zone, box, box-accent, box-soft, box-ok, box-warn, box-err, edge, edge-accent,
// edge-muted, t-title, t-small, t-muted, t-mono; the theme CSS styles them.
import { dropSharedDefs, stableId } from '../../lib/svg';

interface Props {
  title: string;
  caption?: string;
  width: number;
  height: number;
  wide?: boolean;
  class?: string;
}
const { title, caption, width, height, wide, class: cls } = Astro.props;
const id = stableId('fig', title);
const body = dropSharedDefs(await Astro.slots.render('default'));
// The role "img" hides the children from screen readers. A diagram with links is a
// group, so that each link (a Box with href) is announced.
const role = /<a\s/.test(body) ? 'group' : 'img';
---

<figure class:list={['pk-fig', 'not-content', { wide }, cls]}>
  <svg viewBox={`0 0 ${width} ${height}`} role={role} aria-labelledby={id} xmlns="http://www.w3.org/2000/svg">
    <title id={id}>{title}</title>
    <Fragment set:html={body} />
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
