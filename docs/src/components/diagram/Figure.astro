---
// A diagram: an inline SVG with a title for screen readers, the shared arrow marker
// and a caption. Put Zone, Box, Edge and Label inside. The class vocabulary is
// zone, box, box-accent, box-soft, box-ok, box-warn, box-err, edge, edge-accent,
// edge-muted, t-title, t-small, t-muted, t-mono; the theme CSS styles them.
interface Props {
  title: string;
  caption?: string;
  width: number;
  height: number;
  wide?: boolean;
  class?: string;
}
const { title, caption, width, height, wide, class: cls } = Astro.props;
const id = `fig-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class:list={['pk-fig', 'not-content', { wide }, cls]}>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={id} xmlns="http://www.w3.org/2000/svg">
    <title id={id}>{title}</title>
    <defs>
      <marker id="pk-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 10 5 0 10z" fill="context-stroke"></path>
      </marker>
      <pattern id="pk-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" class="hatch"></line>
      </pattern>
    </defs>
    <slot />
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
