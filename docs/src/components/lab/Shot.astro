---
// A screenshot from public/img/lab, with the site base in its address. The lab
// screenshots are mock screens with example data.
interface Props {
  src: string;
  alt: string;
  caption?: string;
  width: number;
  height: number;
}
const { src, alt, caption, width, height } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<figure class="pk-shot not-content">
  <img src={`${base}/img/lab/${src}`} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style is:global>
  .pk-shot {
    margin: 1.5rem 0;
  }
  .pk-shot img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--pk-radius-lg, 10px);
    box-shadow: var(--pk-shadow, none);
  }
  .pk-shot figcaption {
    margin-top: 0.5rem;
    font-size: 0.82rem;
    color: var(--pk-ink-3);
  }
</style>
