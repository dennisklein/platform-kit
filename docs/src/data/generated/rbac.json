{
  "roles": [
    {
      "kind": "ClusterRole",
      "name": "pk-metal-approver",
      "namespace": "",
      "source": "metal/config/rbac/approver_role.yaml",
      "generated": false,
      "description": "The human side of the approval gate. An operation's target and actions are frozen at creation, so a patch cannot change what an operation does; it sets the approval, and the admission policy checks that an approver signs with their own name. Permission to patch IS permission to approve. A patch can also set annotations: abort, retry, and the guard overrides (override-cluster-guard, ignore-window), which let an approved operation run past the etcd quorum guard or outside a maintenance window. So this role also decides who may lift those guards. Bind it to the people (or the group) who may let a disruptive operation run. Nothing binds it by default, and the manager's own role has no patch on operations.\n\nThe same holds for a TalosRollout: what it changes, on which nodes, is frozen at creation and its plan is the operator's status, so a patch approves it, pauses or resumes it, or aborts it. One approval there covers every node's operation of the plan.",
      "rules": [
        {
          "apiGroups": [
            "metal.pk.io"
          ],
          "resources": [
            "hostoperations"
          ],
          "verbs": [
            "get",
            "list",
            "watch",
            "patch"
          ]
        },
        {
          "apiGroups": [
            "metal.pk.io"
          ],
          "resources": [
            "hosts"
          ],
          "verbs": [
            "get",
            "list",
            "watch"
          ]
        },
        {
          "apiGroups": [
            "os.pk.io"
          ],
          "resources": [
            "talosrollouts"
          ],
          "verbs": [
            "get",
            "list",
            "watch",
            "patch"
          ]
        },
        {
          "apiGroups": [
            "os.pk.io"
          ],
          "resources": [
            "talosclusters",
            "talosnodes"
          ],
          "verbs": [
            "get",
            "list",
            "watch"
          ]
        }
      ]
    },
    {
      "kind": "ClusterRole",
      "name": "pk-metal-backup",
      "namespace": "",
      "source": "metal/config/rbac/backup_role.yaml",
      "generated": false,
      "description": "Reading the etcd backup catalogue and asking for a snapshot now (pk-metal backup now|list). Taking a snapshot reads etcd and changes no machine, so this is not part of the approval split; it holds no Secret and cannot decrypt a backup, which only the holders of the age identities can. Restoring one goes through an approved etcdRecover operation (docs site: operate/day-2/restore-etcd). Bind it to the people who look after backups. Nothing binds it by default.",
      "rules": [
        {
          "apiGroups": [
            "os.pk.io"
          ],
          "resources": [
            "etcdbackuppolicies"
          ],
          "verbs": [
